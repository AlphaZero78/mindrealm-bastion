; Engine configuration file.
; Edit through Godot when possible. The project is pinned by development/tools/setup_godot.ps1.

config_version=5

[application]

config/name="心域防线"
run/main_scene="res://scenes/app/main.tscn"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
environment/defaults/default_clear_color=Color(0.012, 0.018, 0.027, 1)

[audio]

driver/enable_input=false

[input]

camera_forward={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
camera_back={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
camera_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
camera_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
camera_rotate_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":81)]
}
camera_rotate_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
camera_focus={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":70)]
}
cancel_action={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}
